prefix=/usr/local
exec_prefix=${prefix}
libdir=/usr/local/lib
includedir=/usr/local/include

Name: libavformat
Description: FFmpeg container format library
Version: 63.8.100
Requires: 
Requires.private: libavcodec >= 63.18.101, libswresample >= 7.3.101, libavutil >= 61.13.100
Conflicts:
Libs: -L${libdir}  -lavformat 
Libs.private: secur32.lib ncrypt.lib crypt32.lib ws2_32.lib
Cflags: -I${includedir}
